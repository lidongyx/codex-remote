{
  "name": "codex-remote",
  "private": true,
  "description": "Unified local-first workspace for the Remodex bridge, relay, and iOS client.",
  "scripts": {
    "bootstrap:node": "npm --prefix phodex-bridge ci && npm --prefix relay ci",
    "bridge:cli": "node ./scripts/remodex-local.js",
    "bridge:up": "node ./scripts/remodex-local.js up",
    "bridge:run": "node ./scripts/remodex-local.js run",
    "bridge:start": "node ./scripts/remodex-local.js start",
    "bridge:restart": "node ./scripts/remodex-local.js restart",
    "bridge:stop": "node ./scripts/remodex-local.js stop",
    "bridge:status": "node ./scripts/remodex-local.js status",
    "bridge:reset-pairing": "node ./scripts/remodex-local.js reset-pairing",
    "dev:bridge": "npm --prefix phodex-bridge start",
    "dev:relay": "npm --prefix relay start",
    "dev:local": "./run-local-remodex.sh",
    "test:bridge": "npm --prefix phodex-bridge test",
    "test:relay": "npm --prefix relay test",
    "test:node": "npm run test:bridge && npm run test:relay"
  },
  "engines": {
    "node": ">=18"
  }
}
